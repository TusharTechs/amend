{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "..\\..\\.venv\\Scripts\\python.exe -m amend.hooks pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "..\\..\\.venv\\Scripts\\python.exe -m amend.hooks post-tool-use",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
